{
  "name": "skillissue",
  "version": "0.3.0",
  "private": true,
  "description": "skillissue.sh — Jack Arturo's personal/agent skills collection",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-catalog.mjs",
    "build:strict": "node scripts/build-catalog.mjs --strict",
    "skills:audit": "node scripts/audit-local-skills.mjs",
    "skills:import": "node scripts/import-local-skills.mjs",
    "harvest:tools": "node scripts/harvest-tool-timeline.mjs",
    "charts": "node scripts/generate-charts.mjs",
    "preview": "python3 -m http.server 8787 --directory site",
    "blog:seed": "npm --prefix blog run seed:build",
    "blog:dev": "npm --prefix blog run dev",
    "blog:build": "npm --prefix blog run build",
    "blog:deploy": "npm --prefix blog run build && npm --prefix blog exec -- wrangler deploy"
  },
  "engines": {
    "node": ">=20"
  }
}
